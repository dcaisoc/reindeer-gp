{
  "name": "reindeer-gp",
  "version": "0.1.0",
  "private": true,
  "description": "Reindeer Grand Prix: drive a sleigh, teach a neural network to drive like you, race the leaderboard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/local/dev-server.ts --watch",
    "build": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && node scripts/check-banned-math.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:golden": "tsx engine/golden/run.ts",
    "test:browser": "npm run build && tsx tests/browser/golden.browser.ts chromium && tsx tests/browser/m1.e2e.ts && tsx tests/browser/m2.e2e.ts && tsx tests/browser/m4.e2e.ts && tsx tests/browser/m5.e2e.ts",
    "golden:update": "tsx engine/golden/generate.ts",
    "tracks": "tsx scripts/gen-tracks.ts",
    "validate:tracks": "tsx scripts/validate-tracks.ts",
    "balance": "tsx scripts/balance.ts",
    "ci": "npm run lint && npm test && npm run test:golden && npm run validate:tracks && npm run build",
    "dev:server": "npm run build && tsx server/local/dev-server.ts",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "dev:pages": "node scripts/build-web.mjs --serve",
    "sdk:sync": "node scripts/sync-sdk-data.mjs",
    "test:sdk": "cd sdk && python3 -m pytest -q",
    "digest": "node scripts/digest.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "loadtest:local": "tsx scripts/loadtest-local.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.50.0"
  }
}
